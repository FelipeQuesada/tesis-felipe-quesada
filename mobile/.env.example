# URL del sitio Next.js para cargar imágenes /public (saludo, blog covers locales, etc.)
# En el CELULAR no uses localhost: usá http://IP_DE_TU_PC:3000 (Next corriendo) o tu URL de Vercel.
# El puerto 8081 es solo Expo/Metro; no va acá.
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:3000

# Firestore: las reglas van en firestore.rules y se publican con:
#   firebase deploy --only firestore:rules
# El hosting (Vercel) no "se conecta" a Firestore por dominio: la app usa las claves de arriba.
# En Firebase Console → Authentication → dominios autorizados sí agregás tu dominio de hosting.

