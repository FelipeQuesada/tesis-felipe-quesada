# Plantilla para la app (Expo).
# Copiá a `mobile/.env` y completá con los mismos valores de Firebase que en la web,
# pero con prefijo EXPO_PUBLIC_ (no NEXT_PUBLIC_).
# No subas `mobile/.env` a Git.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# URL de la web para imágenes /public (en celular usá IP de tu PC o URL de Vercel)
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:3000
